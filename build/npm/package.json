{
  "name": "@cognelis/signoz-cli",
  "version": "0.6.0",
  "description": "Read-only SigNoz queries, diagnostics, profiles, and shell completion for terminals and coding agents.",
  "homepage": "https://github.com/cognelis/signoz-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cognelis/signoz-cli.git",
    "directory": "build/npm"
  },
  "bugs": {"url": "https://github.com/cognelis/signoz-cli/issues"},
  "license": "Apache-2.0",
  "keywords": ["signoz", "observability", "cli", "logs", "metrics", "traces"],
  "bin": {"signoz-cli": "bin/signoz-cli.js"},
  "scripts": {
    "postinstall": "node install.js",
    "prepublishOnly": "node check-release.js",
    "test": "node --test install.test.js",
    "test:package": "node ../../scripts/test-npm-package.js",
    "release:publish": "node ../../scripts/publish-npm.js"
  },
  "files": ["bin/", "install.js", "check-release.js", "README.md", "LICENSE"],
  "engines": {"node": ">=18"},
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"}
}
